# Copie para `.env.local` (ignorado pelo git) e preencha SÓ o que for usar.
# Sem nenhuma variável, o FofoLab roda em MODO DEMONSTRAÇÃO: as respostas da IA são exemplos
# marcados como "Exemplo simulado" e nada é gravado como explicação das questões.

# Recomendado para o .exe distribuído: gateway próprio (a chave fica no servidor, nunca no app).
# O gateway recebe POST {"prompt": "...", "json": true|false} e responde {"reply": "..."}.
VITE_FOFOLAB_AI_GATEWAY_URL=

# Só para desenvolvimento local — variáveis VITE_* são embutidas no bundle do app.
# Groq: plano grátis sem cartão (console.groq.com). Tentado primeiro entre as chaves diretas.
VITE_GROQ_API_KEY=
# Opcional (padrão: qwen/qwen3.8-27b). Os openai/gpt-oss-* inventaram conceitos de auditoria no teste.
VITE_GROQ_MODEL=
VITE_GEMINI_API_KEY=
# Opcional (padrão: gemini-flash-latest). Outros: gemini-flash-lite-latest (mais barato), gemini-3.8-flash.
# Lista do que sua chave enxerga: GET https://generativelanguage.googleapis.com/v1beta/models (header x-goog-api-key)
VITE_GEMINI_MODEL=
VITE_DEEPSEEK_API_KEY=
# Opcional (padrão: deepseek-flash). Outro: deepseek-v4-pro (~3x mais caro).
VITE_DEEPSEEK_MODEL=
