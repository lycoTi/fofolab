# Dependencies
node_modules/
dist/
dist-ssr/
*.local

# Tauri / Rust build artifacts
src-tauri/target/
src-tauri/WixTools/

# Local SQLite database & user packs (keep personal study data local or in Google Drive)
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.fofopack

# Environment variables & API keys
.env
.env.*
!.env.example

# IDE & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Playwright (E2E)
test-results/
playwright-report/
e2e/.screens/

# Cache incremental do TypeScript (muda a cada build; conflita entre PCs)
*.tsbuildinfo

# Agentes: skills do projeto vivem em .agents/skills (versionado); .claude/ é gerado por máquina
# (atalhos do check-stack.ps1, impeccable instalado por `npx impeccable install --providers=claude --project -y`).
.claude/skills/
.claude/agents/
.claude/settings.local.json

# impeccable-ignore-start
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end

# Esboços do brainstorming (companheiro visual)
.superpowers/

# graphify: o grafo e o relatório vão para o repositório (servem aos dois PCs); o cache cada máquina refaz
graphify-out/cache/
